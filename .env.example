GEMINI_API_KEY=your-ai-studio-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
# Optional overrides
# ANALYZER=opencode         # opencode | openrouter | local | gemini
# OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# LOCAL_MODEL=gemma-4-12b   # needs: ollama serve
# OLLAMA_URL=http://localhost:11434
# ANALYZE_MODEL=gemini-3.6-flash
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS engine: gemini (API, quota-limited) | vieneu (local, unlimited)
# TTS_ENGINE=vieneu
# Remote TTS worker (model runs on another machine; everything else stays local)
# TTS_HOST=http://gpu-box:8818
# Gemini chain order (newest first). Per-model free limits: 3 RPM, 10k TPM, 10 RPD.
# GEMINI_MODEL_ORDER=gemini-3.1-flash-tts-preview gemini-2.5-pro-preview-tts gemini-2.5-flash-preview-tts
# NOTE: the Gemini app subscription ("AI Plus") does NOT raise API quotas.
# Free API tier = ~10 TTS calls/day. For chapters, enable billing in AI Studio
# (pay-as-you-go, pennies per chapter) to lift limits.
